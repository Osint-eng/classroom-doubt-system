{
  "info": {
    "name": "Classroom Doubt System API",
    "description": "Sandbox/local API smoke tests for the FastAPI routes. Set baseUrl first. Use a disposable test database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "questionId",
      "value": ""
    },
    {
      "key": "answerId",
      "value": ""
    },
    {
      "key": "testUserId",
      "value": "postman-smoke-user"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API responds', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"ChangeThis-Test-123!\",\n  \"role\": \"student\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now();",
              "pm.collectionVariables.set('testEmail', `postman-${stamp}@example.test`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register returns 200', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const body = pm.response.json();",
              "if (body.token) pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login test user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"ChangeThis-Test-123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.token).to.be.a('string');",
              "pm.collectionVariables.set('token', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create question",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman smoke-test question\",\n  \"description\": \"Disposable question created by the Postman collection.\",\n  \"subject\": \"Testing\",\n  \"tags\": \"smoke-test\"\n}"
        },
        "url": "{{baseUrl}}/api/questions/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Question creation succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.be.a('string');",
              "pm.collectionVariables.set('questionId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List questions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/questions/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Question list succeeds', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add answer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"author\": \"{{testUserId}}\",\n  \"content\": \"Disposable answer from the Postman smoke test.\"\n}"
        },
        "url": "{{baseUrl}}/api/answers/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Answer creation succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.expect(body.id).to.be.a('string');",
              "pm.collectionVariables.set('answerId', body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List answers for question",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/answers/{{questionId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Answer list succeeds', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    }
  ]
}
